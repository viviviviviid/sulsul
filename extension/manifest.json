{
  "manifest_version": 3,
  "name": "술술 — 웹을 편하게",
  "description": "내가 선택한 AI로 웹페이지·게시글·댓글을 쉬운 한국어로 바꿉니다. 새로 나타나는 내용도 읽던 자리에서 번역합니다.",
  "version": "0.7.0",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "술술 · 쉽게 읽기"
  },
  "commands": {
    "toggle-reading": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "쉽게 읽기 / 일시중지 / 이어 읽기"
    }
  },
  "key": ""
}
